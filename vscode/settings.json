{
  "editor.wordWrap": "on",
  "editor.fontFamily": "'Fira Code Medium','Fira Code Nerd','cascadia code', 'Courier New', monospace",
  "editor.guides.bracketPairsHorizontal": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.inlineSuggest.fontFamily": "default",
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "debug.terminal.clearBeforeReusing": true,
  "code-runner.clearPreviousOutput": true,
  "workbench.editorAssociations": {
    "*.log": "default"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "emmet.includeLanguages": {
    "ejs": "html",
    "javascript": "javascriptreact"
  },
  "workbench.settings.applyToAllProfiles": ["editor", "terminal", "files"],
  "editor.cursorStyle": "underline",
  "editor.cursorBlinking": "phase",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.indentation": true,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.fontFamily": "FiraCode Nerd Font Mono",
  "terminal.integrated.fontWeight": "600",
  "terminal.integrated.fontWeightBold": "700",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.tabs.defaultIcon": "terminal-linux",
  "terminal.integrated.defaultProfile.windows": "PowerShell 7",
  "terminal.integrated.profiles.windows": {
    "PowerShell 7": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "files.autoSave": "afterDelay",
  "files.eol": "\n",
  "livePreview.customExternalBrowser": "Edge",
  "livePreview.openPreviewTarget": "External Browser",
  "mdb.mcp.server": "prompt",
  "editor.renderWhitespace": "none",
  "redhat.telemetry.enabled": false,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Best Themes - Ayu Darkvenom",
  "window.newWindowProfile": "Default",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "python.analysis.typeCheckingMode": "standard",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "makefile.configureOnOpen": true,
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "json.suggest.trailingCommas": false,
  "chat.disableAIFeatures": true,
  "zig.zls.enabled": "on",
  "zig.path": "zig",
  "editor.unicodeHighlight.invisibleCharacters": false,
  "telemetry.telemetryLevel": "off"
}
